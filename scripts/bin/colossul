#!/usr/bin/env bash
# Operator CLI for the Colossul multi-seat instance.
#
#   colossul status          per-seat process state
#   colossul urls            the URL to hand each employee
#   colossul logs 2          tail seat 2's three services
#   colossul restart 2       recycle one employee's stack
#   colossul restart all     recycle every seat
#   colossul gpu             nvidia-smi, annotated with seat ownership
#   colossul ram             host RAM, and what each seat is actually using
#   colossul nodes           re-install custom nodes (after editing the manifest)
#   colossul models-log      follow the background model download
#   colossul models --list   model sets available to download, and sizes
#   colossul models --check  verify URLs, sizes and disk, downloading nothing
#   colossul models minimax-h3   download that set into the shared store
#   colossul provision       re-run provisioning (picks up new commits)
#   colossul rebuild         force a full rebuild, then re-provision
#   colossul self-update     fetch newer Colossul scripts onto this box
#   colossul version         what is installed here
set -euo pipefail

# Resolve the shared lib from the installed location, falling back to the
# repo layout so the CLI can be exercised without building the image.
_LIB="${COLOSSUL_LIB:-/opt/colossul}/lib/common.sh"
[ -f "$_LIB" ] || _LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"
# shellcheck source=../lib/common.sh
source "$_LIB"

SEAT_COUNT="$(num_seats)"
# shellcheck disable=SC1090  # generated at provision time
[ -f "$RUNTIME_ENV" ] && source "$RUNTIME_ENV"
SEAT_COUNT="${NUM_SEATS:-$SEAT_COUNT}"

# Print the header comment block as help. Derived from the file rather than a
# fixed line range so editing the commands can't desync the help text.
usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; }

require_seat() {
    local s="${1:-}"
    [ -n "$s" ] || die "a seat index (0..$((SEAT_COUNT - 1))) is required"
    case "$s" in ''|*[!0-9]*) die "'$s' is not a seat index" ;; esac
    [ "$s" -lt "$SEAT_COUNT" ] || die "seat $s does not exist (this instance has $SEAT_COUNT seats)"
}

# Public host for the URLs. Vast exposes the instance address via these vars;
# fall back to a placeholder rather than printing something wrong.
public_host() {
    echo "${PUBLIC_IPADDR:-${VAST_IP_ADDR:-<instance-host>}}"
}

cmd_status() {
    local i
    for ((i = 0; i < SEAT_COUNT; i++)); do
        echo "── seat $i  (GPU $(gpu_for_seat "$i")) ─────────────────────────────"
        supervisorctl status "seat${i}:*" 2>/dev/null || echo "  not registered — run: colossul provision"
    done
}

# Same block provisioning prints at the end of boot - one implementation, so
# what an operator reads later always matches what they saw then.
cmd_urls() { print_access_summary "$SEAT_COUNT"; }

cmd_logs() {
    local seat="${1:-}"
    require_seat "$seat"
    local files=()
    local svc
    for svc in comfyui backend frontend; do
        local f="/var/log/portal/seat${seat}-${svc}.log"
        [ -f "$f" ] && files+=("$f")
    done
    [ "${#files[@]}" -gt 0 ] || die "no logs yet for seat $seat"
    tail -n 60 -F "${files[@]}"
}

cmd_restart() {
    local target="${1:-}"
    if [ "$target" = "all" ]; then
        local i
        for ((i = 0; i < SEAT_COUNT; i++)); do
            log "restarting seat $i ..."
            supervisorctl restart "seat${i}:*" || warn "seat $i restart reported an error"
        done
        return 0
    fi
    require_seat "$target"
    log "restarting seat $target ..."
    supervisorctl restart "seat${target}:*"
}

cmd_gpu() {
    command -v nvidia-smi >/dev/null 2>&1 || die "nvidia-smi is unavailable in this container"
    echo ""
    echo "  Seat → GPU assignment:"
    local i
    for ((i = 0; i < SEAT_COUNT; i++)); do
        echo "    seat $i  ->  GPU $(gpu_for_seat "$i")"
    done
    echo ""
    nvidia-smi
}

# "98% used" on the Vast dashboard is usually page cache from reading hundreds
# of gigabytes of weights, which the kernel hands back on demand. The number
# that matters is `available`, and which processes hold ANONYMOUS memory.
cmd_ram() {
    echo ""
    echo "  Host memory (available is the number that matters — used includes"
    echo "  reclaimable page cache from reading model files):"
    free -h | sed 's/^/    /'
    echo ""

    # The number the Vast dashboard shows comes from the CONTAINER's cgroup, and
    # that charge includes cached file pages. Downloading a few hundred GB of
    # weights therefore reads as "memory used" while being entirely reclaimable
    # — which is why the figure can even exceed the machine's RAM.
    #
    # anon is what processes actually hold and cannot be handed back; file is
    # cache the kernel drops the moment anything needs the space.
    local st="" lim=""
    if [ -r /sys/fs/cgroup/memory.stat ]; then                     # cgroup v2
        st=/sys/fs/cgroup/memory.stat
        [ -r /sys/fs/cgroup/memory.max ] && lim="$(cat /sys/fs/cgroup/memory.max)"
    elif [ -r /sys/fs/cgroup/memory/memory.stat ]; then            # cgroup v1
        st=/sys/fs/cgroup/memory/memory.stat
        [ -r /sys/fs/cgroup/memory/memory.limit_in_bytes ] && \
            lim="$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes)"
    fi
    if [ -n "$st" ]; then
        echo "  Container cgroup — this is what the Vast dashboard reports:"
        awk -v lim="${lim:-max}" '
            $1 == "anon"        { anon = $2 }
            $1 == "file"        { file = $2 }
            $1 == "total_rss"   { anon = $2 }   # v1 names
            $1 == "total_cache" { file = $2 }
            END {
                printf "    processes (anon)   %8.1f GB   <- real, not reclaimable\n", anon/1073741824
                printf "    page cache (file)  %8.1f GB   <- reclaimable on demand\n", file/1073741824
                if (lim ~ /^[0-9]+$/)
                    printf "    cgroup limit       %8.1f GB\n", lim/1073741824
                else
                    printf "    cgroup limit       %8s\n", lim
            }' "$st"
        echo ""
        echo "    If page cache is the large number, nothing is wrong: it is the"
        echo "    model library passing through on its way to disk."
        echo ""
    fi

    echo "  Per-seat ComfyUI resident memory:"
    printf '    %-6s %-10s %-10s %s\n' "SEAT" "RSS" "PID" "STATE"
    local i pid rss
    for ((i = 0; i < SEAT_COUNT; i++)); do
        pid="$(supervisorctl pid "seat${i}-comfyui" 2>/dev/null || echo 0)"
        if [ "${pid:-0}" -gt 0 ] 2>/dev/null; then
            rss="$(awk '/VmRSS/{printf "%.1f GB", $2/1048576}' "/proc/$pid/status" 2>/dev/null)"
            printf '    %-6s %-10s %-10s %s\n' "$i" "${rss:-?}" "$pid" "running"
        else
            printf '    %-6s %-10s %-10s %s\n' "$i" "-" "-" "not running"
        fi
    done
    echo ""
    echo "  Cache eviction threshold: ComfyUI frees cached node outputs once"
    echo "  free RAM drops below ${COLOSSUL_CACHE_RAM:-$((8 * SEAT_COUNT))} GB."
    echo "  Tune with COLOSSUL_CACHE_RAM (\"active\" or \"active inactive\", GB)."
    echo ""
}

case "${1:-}" in
    status)    shift; cmd_status "$@" ;;
    ram)       shift; cmd_ram "$@" ;;
    urls)      shift; cmd_urls "$@" ;;
    logs)      shift; cmd_logs "$@" ;;
    restart)   shift; cmd_restart "$@" ;;
    gpu)       shift; cmd_gpu "$@" ;;
    nodes)     shift
               "${COLOSSUL_LIB:-/opt/colossul}/install-custom-nodes.sh" "$@"
               echo ""
               log "Restart seats to load them:  colossul restart all"
               ;;
    models)    shift
               exec "${COLOSSUL_LIB:-/opt/colossul}/install-models.sh" "$@"
               ;;
    models-log) shift
               f=/var/log/portal/models.log
               [ -f "$f" ] || die "no model download has run (MODEL_SETS is empty?)"
               echo "── $(supervisorctl status colossul-models 2>/dev/null || echo 'job not registered') ──"
               tail -n 40 -F "$f"
               ;;
    self-update) shift
               exec "${COLOSSUL_LIB:-/opt/colossul}/self-update.sh" "$@"
               ;;
    version)   shift
               v="$(cat "${COLOSSUL_LIB:-/opt/colossul}/.colossul-version" 2>/dev/null || true)"
               echo "colossul scripts: ${v:-image build (no self-update applied)}"
               echo "ComfyUI ref     : ${COMFYUI_REF:-<image default>}"
               echo "model sets      : ${MODEL_SETS:-<none>}"
               echo "seats           : $SEAT_COUNT"
               ;;
    provision) shift; exec /opt/colossul/provision.sh ;;
    rebuild)   shift; FORCE_REPROVISION=1 exec /opt/colossul/provision.sh ;;
    ""|-h|--help|help) usage ;;
    *)         echo "unknown command: $1" >&2; echo "" >&2; usage >&2; exit 2 ;;
esac
